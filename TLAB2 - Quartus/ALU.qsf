set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C6GES
set_global_assignment -name TOP_LEVEL_ENTITY ALU
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 19.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "21:33:57  OCTOBER 31, 2024"
set_global_assignment -name LAST_QUARTUS_VERSION "19.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name BOARD "MAX 10 DE10 - Lite"
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name VHDL_FILE XOR0.vhd
set_global_assignment -name VHDL_FILE ANDL.vhd
set_global_assignment -name VHDL_FILE NANDL.vhd
set_global_assignment -name VHDL_FILE MUX_ALU.vhd
set_global_assignment -name VHDL_FILE MUX.vhd
set_global_assignment -name VHDL_FILE LU.vhd
set_global_assignment -name VHDL_FILE LSR.vhd
set_global_assignment -name VHDL_FILE LSL.vhd
set_global_assignment -name VHDL_FILE FULLADDER.vhd
set_global_assignment -name VHDL_FILE FLAGS_ALU.vhd
set_global_assignment -name VHDL_FILE FLAGS.vhd
set_global_assignment -name VHDL_FILE DECODER.vhd
set_global_assignment -name VHDL_FILE AU.vhd
set_global_assignment -name VHDL_FILE ASR.vhd
set_global_assignment -name VHDL_FILE ADDSUB.vhd
set_global_assignment -name VHDL_FILE ADDER.vhd
set_global_assignment -name VHDL_FILE ALU.vhd
set_global_assignment -name VHDL_FILE ALU_tb.vhd
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# ========================================================================
# PIN ASSIGNMENTS FOR DE10-LITE (from colinha_pinos.pdf)
# ========================================================================

# INPUTS
# X[3..0] = SW3..SW0 (operando 1)
set_location_assignment PIN_L20 -to X[0]
set_location_assignment PIN_L19 -to X[1]
set_location_assignment PIN_U14 -to X[2]
set_location_assignment PIN_V14 -to X[3]

# Y[3..0] = SW7..SW4 (operando 2)
set_location_assignment PIN_W14 -to Y[0]
set_location_assignment PIN_V15 -to Y[1]
set_location_assignment PIN_U15 -to Y[2]
set_location_assignment PIN_W15 -to Y[3]

# OP[1..0] = SW9..SW8 (bits menos significativos de OP)
set_location_assignment PIN_W16 -to OP[0]
set_location_assignment PIN_V16 -to OP[1]

# OP[2] = KEY0 (esq.) - bit mais significativo de OP (active-low: pressionado=0)
set_location_assignment PIN_V17 -to OP[2]

# CBi = KEY1 (dir.) - Carry-In (active-low: pressionado=0)
set_location_assignment PIN_W17 -to CBi

# OUTPUTS
# R[3..0] = LEDR3..LEDR0 (resultado)
set_location_assignment PIN_W19 -to R[0]
set_location_assignment PIN_V19 -to R[1]
set_location_assignment PIN_U19 -to R[2]
set_location_assignment PIN_U20 -to R[3]

# CBo = LEDR4 (Carry/Borrow out)
set_location_assignment PIN_V20 -to CBo

# OV = LEDR5 (Overflow)
set_location_assignment PIN_W20 -to OV

# Z = LEDR6 (Zero)
set_location_assignment PIN_Y19 -to Z

# GE = LEDR7 (Greater or Equal signed)
set_location_assignment PIN_Y20 -to GE

# BE = LEDR8 (Below or Equal unsigned)
set_location_assignment PIN_AA19 -to BE