# Quartus Prime Settings File for ALU - DE10-Lite
# Dispositivo: 10M50DAF484C7G (se a placa for engineering sample, trocar por 10M50DAF484C6GES)
# Pinos conforme o manual da DE10-Lite (confirmar no Pin Planner)

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY ALU
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name BOARD "MAX 10 DE10 - Lite"
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# VHDL files (o testbench alu_tb.vhd NAO entra no projeto de sintese)
set_global_assignment -name VHDL_FILE half_adder.vhd
set_global_assignment -name VHDL_FILE full_adder.vhd
set_global_assignment -name VHDL_FILE adder4.vhd
set_global_assignment -name VHDL_FILE au_module.vhd
set_global_assignment -name VHDL_FILE xor0.vhd
set_global_assignment -name VHDL_FILE mux2_1.vhd
set_global_assignment -name VHDL_FILE logic_module.vhd
set_global_assignment -name VHDL_FILE decode_op.vhd
set_global_assignment -name VHDL_FILE flags_alu.vhd
set_global_assignment -name VHDL_FILE alu.vhd

# ========================================================================
# ENTRADAS
# ========================================================================
# X = SW3..0
set_location_assignment PIN_C10 -to X[0]
set_location_assignment PIN_C11 -to X[1]
set_location_assignment PIN_D12 -to X[2]
set_location_assignment PIN_C12 -to X[3]
# Y = SW7..4
set_location_assignment PIN_A12 -to Y[0]
set_location_assignment PIN_B12 -to Y[1]
set_location_assignment PIN_A13 -to Y[2]
set_location_assignment PIN_A14 -to Y[3]
# OP1..0 = SW9..8
set_location_assignment PIN_B14 -to OP[0]
set_location_assignment PIN_F15 -to OP[1]
# OP2 = KEY0, CBi = KEY1 (botoes ativos a zero: premido = 0)
set_location_assignment PIN_B8 -to OP[2]
set_location_assignment PIN_A7 -to CBi

# ========================================================================
# SAIDAS (LEDs vermelhos)
# ========================================================================
# R = LEDR3..0
set_location_assignment PIN_A8  -to R[0]
set_location_assignment PIN_A9  -to R[1]
set_location_assignment PIN_A10 -to R[2]
set_location_assignment PIN_B10 -to R[3]
# CBo = LEDR4, OV = LEDR5, Z = LEDR6, GE = LEDR7, BE = LEDR8
set_location_assignment PIN_D13 -to CBo
set_location_assignment PIN_C13 -to OV
set_location_assignment PIN_E14 -to Z
set_location_assignment PIN_D14 -to GE
set_location_assignment PIN_A11 -to BE
