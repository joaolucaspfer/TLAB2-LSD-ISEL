# Quartus Prime Settings File for ALU - DE10-Lite
# Dispositivo: 10M50DAF484C7G (MAX 10, DE10-Lite) - CONFORME SPEC
# Pinos OFICIAIS DE10-Lite (manual Terasic / reference design 10M50DAF484C7G)

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY ALU
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name BOARD "MAX 10 DE10 - Lite"
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

# VHDL files (ordem de compilação)
set_global_assignment -name VHDL_FILE half_adder.vhd
set_global_assignment -name VHDL_FILE full_adder.vhd
set_global_assignment -name VHDL_FILE adder4.vhd
set_global_assignment -name VHDL_FILE au_module.vhd
set_global_assignment -name VHDL_FILE xor0.vhd
set_global_assignment -name VHDL_FILE mux2_1.vhd
set_global_assignment -name VHDL_FILE logic_module.vhd
set_global_assignment -name VHDL_FILE decode_op.vhd
set_global_assignment -name VHDL_FILE flags_alu.vhd
set_global_assignment -name VHDL_FILE alu.vhd
set_global_assignment -name VHDL_FILE alu_tb.vhd

# ========================================================================
# PIN ASSIGNMENTS DE10-LITE OFICIAIS (10M50DAF484C7G - package F484)
# SW[0..9] = PIN_A8, B9, A9, A10, B10, A11, B11, A12, B12, A13
# KEY[0..1] = PIN_B14, A14
# LEDR[0..9] = PIN_A15, A16, B15, B16, A17, A18, B17, B18, A19, A20
# ========================================================================

# X[3..0] = SW[3..0]
set_location_assignment PIN_A8  -to X[0]
set_location_assignment PIN_B9  -to X[1]
set_location_assignment PIN_A9  -to X[2]
set_location_assignment PIN_A10 -to X[3]

# Y[3..0] = SW[7..4]
set_location_assignment PIN_B10 -to Y[0]
set_location_assignment PIN_A11 -to Y[1]
set_location_assignment PIN_B11 -to Y[2]
set_location_assignment PIN_A12 -to Y[3]

# OP[1..0] = SW[9..8]
set_location_assignment PIN_B12 -to OP[0]
set_location_assignment PIN_A13 -to OP[1]

# OP[2] = KEY[0] (active-low)
set_location_assignment PIN_B14 -to OP[2]

# CBi = KEY[1] (active-low)
set_location_assignment PIN_A14 -to CBi

# R[3..0] = LEDR[3..0]
set_location_assignment PIN_A15 -to R[0]
set_location_assignment PIN_A16 -to R[1]
set_location_assignment PIN_B15 -to R[2]
set_location_assignment PIN_B16 -to R[3]

# CBo = LEDR[4]
set_location_assignment PIN_A17 -to CBo

# OV = LEDR[5]
set_location_assignment PIN_A18 -to OV

# Z = LEDR[6]
set_location_assignment PIN_B17 -to Z

# GE = LEDR[7]
set_location_assignment PIN_B18 -to GE

# BE = LEDR[8]
set_location_assignment PIN_A19 -to BE